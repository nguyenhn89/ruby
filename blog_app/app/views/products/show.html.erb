<div class="bg-white rounded shadow p-6 max-w-lg">
  <h1 class="text-2xl font-bold text-gray-800 mb-4"><%= @product.name %></h1>

  <div class="space-y-3 text-sm text-gray-700">
    <div><span class="font-semibold">Mô tả:</span> <%= @product.description %></div>
    <div><span class="font-semibold">Giá:</span> <%= number_to_currency(@product.price, unit: "₫", separator: ",", delimiter: ".", format: "%n %u") %></div>
    <div><span class="font-semibold">Tồn kho:</span> <%= @product.stock %></div>
  </div>

  <div class="flex gap-3 mt-6">
    <%= link_to "Sửa", edit_product_path(@product), class: "bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600" %>
    <%= link_to "Quay lại", products_path, class: "bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300" %>
  </div>
</div>
