<%= form_with model: product, class: "space-y-4" do |f| %>
  <% if product.errors.any? %>
    <div class="bg-red-100 text-red-700 px-4 py-3 rounded">
      <% product.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Tên sản phẩm", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <div>
    <%= f.label :description, "Mô tả", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <div>
    <%= f.label :price, "Giá", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :price, step: 0.01, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <div>
    <%= f.label :stock, "Tồn kho", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :stock, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <div>
    <%= f.submit class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
  </div>
<% end %>
