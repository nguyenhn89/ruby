<!DOCTYPE html>
<html>
  <head>
    <title>BlogApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 h-screen flex flex-col overflow-hidden">
    <nav class="bg-white shadow-md mb-8">
      <div class="container mx-auto px-6 py-0">
        <div class="flex items-center h-14 gap-8">
          <%= link_to "BlogApp", root_path, class: "text-lg font-bold text-blue-600 tracking-wide mr-4" %>
          <div class="flex items-center gap-1">
            <%= link_to "Sản phẩm", products_path, class: "px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors" %>
            <%= link_to "Danh mục", categories_path, class: "px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors" %>
          </div>
          <div class="ml-auto flex items-center gap-2">
            <% if user_signed_in? %>
              <span class="text-sm text-gray-500"><%= current_user.email %></span>
              <%= link_to "Đăng xuất", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-4 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 transition-colors" %>
            <% else %>
              <%= link_to "Đăng nhập", new_user_session_path, class: "px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors" %>
              <%= link_to "Đăng ký", new_user_registration_path, class: "px-4 py-2 rounded-md text-sm font-medium bg-blue-600 text-white hover:bg-blue-700 transition-colors" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mx-auto px-6 flex-1 overflow-y-auto py-6">
      <%= yield %>
    </main>
  </body>
</html>
