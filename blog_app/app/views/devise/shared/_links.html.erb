<%- if controller_name != 'sessions' %>
  <%= link_to "Đăng nhập", new_session_path(resource_name), class: "text-blue-600 hover:underline" %>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to "Chưa có tài khoản? Đăng ký", new_registration_path(resource_name), class: "block text-blue-600 hover:underline" %>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to "Quên mật khẩu?", new_password_path(resource_name), class: "block text-gray-500 hover:underline" %>
<% end %>
