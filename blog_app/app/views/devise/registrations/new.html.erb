<div class="bg-white rounded-xl shadow-md w-full max-w-md px-8 py-10">
  <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Đăng ký</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-4">
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <div>
        <%= f.label :password, "Mật khẩu", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-1">Tối thiểu <%= @minimum_password_length %> ký tự</p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Xác nhận mật khẩu", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
      </div>

      <%= f.submit "Đăng ký", class: "w-full bg-blue-600 text-white py-2 rounded-lg font-medium hover:bg-blue-700 transition-colors cursor-pointer mt-2" %>
    </div>
  <% end %>

  <div class="mt-6 space-y-2 text-center text-sm">
    <%= render "devise/shared/links" %>
  </div>
</div>
